      "answers": [
        {
          "id": "what.basic.01",
          "style": "平实叙述",
          "register": "说明文",
          "content": "知识是人类对自己过往经验总和的一种定义。人把反复出现的感受、动作与结果记下来，归并成可以复用的说法，这些说法的外化就是知识。离开经验输入，就没有可供归纳的材料，也就不会产生新的知识。因此知识不来自凭空的推演，本质上是经验主义的外化。",
          "content_hash": "2dc1dcd4d9f33958",
          "covers": [
            "i1",
            "i2",
            "i3"
          ],
          "misses": [],
          "author": {
            "name": "simple-calcate",
            "link": ""
          },
          "source": {
            "type": "original",
            "note": "本库认定的正确答案，依据见 canonical 卡片"
          },
          "created_at": "2026-11-04"
        },
        {
          "id": "what.basic.02",
          "style": "比喻",
          "register": "口语",
          "content": "把一个人的一生想成一本流水账：每次经历都记一笔，记多了就发现某些笔迹总是一起出现。把这些反复出现的搭配抄成几条口诀，口诀就是知识。账本里没写过的东西，口诀里也不会凭空冒出来——所以说到底，知识是经验攒出来的，是经验主义落到纸面上的样子。",
          "content_hash": "3a5ba6a9950d49ed",
          "covers": [
            "i1",
            "i2",
            "i3"
          ],
          "misses": [],
          "author": {
